{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiying2007.local/codex/runtime-execution-receipt.v2.schema.json",
  "title": "Codex Runtime Execution Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "run_id",
    "execution_source_set_identity",
    "digital_worker_governance_identity",
    "runtime_binding",
    "agent_assets",
    "runtime",
    "permissions",
    "repository",
    "execution",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "work_item_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "execution_source_set_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digital_worker_governance_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "target",
        "runtime_profile",
        "runtime_host",
        "source_set_identity_ref",
        "runtime_distribution_identity_ref"
      ],
      "properties": {
        "repository": {"const": "jiying2007/codex"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target": {"const": "codex-cli"},
        "runtime_profile": {"type": "string", "minLength": 1},
        "runtime_host": {"type": "string", "minLength": 1},
        "source_set_identity_ref": {"type": "string", "minLength": 1},
        "runtime_distribution_identity_ref": {"type": "string", "minLength": 1}
      }
    },
    "agent_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_repository",
        "release_version",
        "release_tag",
        "release_commit",
        "asset_profile",
        "source_set_identity"
      ],
      "properties": {
        "provider_repository": {"const": "jiying2007/agent-dev-kit"},
        "release_version": {"type": "string", "minLength": 1},
        "release_tag": {"type": "string", "minLength": 1},
        "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "asset_profile": {"type": "string", "minLength": 1},
        "source_set_identity": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "cli_version", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "cli_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_provider": {"type": "string", "minLength": 1},
        "mcp_fingerprint": {"type": "string"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "approval"],
      "properties": {
        "sandbox": {"type": "string", "minLength": 1},
        "approval": {"type": "string", "minLength": 1},
        "network": {"type": "string"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_commit", "result_commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "result_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime_local_gates"],
      "properties": {
        "status": {"enum": ["completed", "blocked", "failed", "cancelled"]},
        "runtime_local_gates": {"type": "array", "items": {"type": "string"}},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "not": {
    "anyOf": [
      {"required": ["verification_pass"]},
      {"required": ["release_ready"]},
      {"required": ["domain_gate_pass"]},
      {"required": ["asset_bundle_hash"]}
    ]
  }
}
