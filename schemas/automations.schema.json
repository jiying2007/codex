{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Automations Manifest",
  "type": "object",
  "required": ["schema_version", "automations"],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "mode",
          "type",
          "profiles",
          "workflow",
          "cadence",
          "scope",
          "sandbox",
          "approval_policy",
          "worktree_policy",
          "first_run_review",
          "risk_class",
          "requires_worktree_for_write",
          "stop_condition",
          "triage_contract",
          "run_lifecycle",
          "output_artifacts"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": ["report-only", "manual-review", "assist"]
          },
          "type": {
            "type": "string",
            "enum": ["scheduled", "thread"]
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          },
          "scope": {
            "type": "object"
          },
          "sandbox": {
            "type": "string",
            "enum": ["read-only", "workspace-write"]
          },
          "approval_policy": {
            "type": "string",
            "enum": ["on-request", "on-failure", "manual"]
          },
          "worktree_policy": {
            "type": "string"
          },
          "first_run_review": {
            "type": "boolean"
          },
          "risk_class": {
            "type": "string",
            "enum": ["read-only", "draft-write", "external-write"]
          },
          "requires_worktree_for_write": {
            "type": "boolean"
          },
          "stop_condition": {
            "type": "string"
          },
          "triage_contract": {
            "type": "object",
            "required": ["destination", "allowed_outputs", "forbidden_actions"],
            "properties": {
              "destination": {
                "type": "string"
              },
              "allowed_outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbidden_actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "run_lifecycle": {
            "type": "object",
            "required": ["first_run", "steady_state", "stale_after", "retry_budget", "cleanup", "retention"],
            "properties": {
              "first_run": {
                "type": "string"
              },
              "steady_state": {
                "type": "string"
              },
              "stale_after": {
                "type": "string"
              },
              "retry_budget": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "cleanup": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "retention": {
                "type": "string"
              }
            }
          },
          "output_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
