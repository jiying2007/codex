{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Slash Command Runtime Audits Manifest",
  "type": "object",
  "required": ["schema_version", "slash_command_runtime_audits"],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "slash_command_runtime_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "profiles",
          "command_contract",
          "command",
          "risk_class",
          "audit_events",
          "runtime_controls",
          "required_evidence",
          "forbidden_actions",
          "retention",
          "review_required",
          "verification",
          "artifacts"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command_contract": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "risk_class": {
            "type": "string",
            "enum": ["context-control", "review-control", "goal-control", "permission-control", "model-control"]
          },
          "audit_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retention": {
            "type": "string"
          },
          "review_required": {
            "type": "boolean"
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
