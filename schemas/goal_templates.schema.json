{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Goal Templates Manifest",
  "type": "object",
  "required": ["schema_version", "goal_templates"],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "goal_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "profiles",
          "workflow",
          "goal_strength",
          "required_fields",
          "verification_contract",
          "artifact_contract",
          "stop_conditions",
          "negative_examples"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "string"
          },
          "goal_strength": {
            "type": "string",
            "enum": ["weak", "strong", "continuous"]
          },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_contract": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_contract": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
