{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Workflows Manifest",
  "type": "object",
  "required": ["schema_version", "workflows"],
  "properties": {
    "schema_version": {"type": "integer"},
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "match_any",
                "exclude_any",
                "primary_skill",
                "supporting_skills",
                "fallback_skill",
                "mutually_exclusive_skills"
              ],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "match_any": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                },
                "exclude_any": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "primary_skill": {"type": "string", "minLength": 1},
                "supporting_skills": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "fallback_skill": {"type": "string"},
                "mutually_exclusive_skills": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
