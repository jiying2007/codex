{
  "schema_version": 1,
  "defaults": {
    "top": 3,
    "warn_thread_tokens": 50000000,
    "context_pressure_ratio": 0.5,
    "large_delta_tokens": 100000,
    "evidence_fresh_minutes": 240,
    "archive_max_bytes": 262144
  },
  "events": {
    "final": {
      "phase": "handoff",
      "required_evidence": "final-ready"
    },
    "commit": {
      "phase": "commit",
      "required_evidence": "commit-ready"
    },
    "push": {
      "phase": "commit",
      "required_evidence": "commit-ready"
    },
    "apply": {
      "phase": "apply",
      "required_evidence": "apply-ready"
    },
    "resume": {
      "phase": "handoff"
    },
    "target-switch": {
      "phase": "handoff"
    },
    "memory-curation": {
      "phase": "archive"
    }
  },
  "protected_archive_patterns": [
    "(?i)api[_-]?key",
    "(?i)authorization",
    "(?i)bearer",
    "(?i)\\bpassword\\b\\s*[:=]\\s*['\\\"]?[^\\s'\\\"]{8,}",
    "(?i)private key",
    "BEGIN [A-Z ]*PRIVATE KEY",
    "sk-[A-Za-z0-9]"
  ]
}
