{
  "schema_version": 1,
  "context_state_contracts": [
    {
      "name": "session-continuity-context-state",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "scope": "context-preflight and session handoff artifacts",
      "layers": {
        "stable": {
          "required_fields": [
            "repo rules",
            "durable decisions",
            "validated workflow contracts"
          ],
          "destinations": [
            "AGENTS.md",
            "~/knowledge-hub/domains/codex/archive/codex-archive",
            "manifest"
          ],
          "promotion_gate": "reviewed, secret-scanned and covered by guidance_promotions"
        },
        "dynamic": {
          "required_fields": [
            "current goal",
            "worktree state",
            "next command",
            "blockers"
          ],
          "destinations": [
            "context-preflight",
            "session summary"
          ],
          "promotion_gate": "must expire or be reclassified before long-term promotion"
        },
        "evidence": {
          "required_fields": [
            "command",
            "result",
            "artifact",
            "negative result"
          ],
          "destinations": [
            "final evidence",
            "commit evidence",
            "archive note"
          ],
          "promotion_gate": "must remain tied to reproducible command or artifact"
        },
        "excluded": {
          "required_fields": [
            "secrets",
            "session raw logs",
            "cache",
            "unreviewed memory"
          ],
          "destinations": [
            "none"
          ],
          "promotion_gate": "never promote"
        }
      },
      "validation_commands": [
        "rtk bash scripts/context-preflight.sh",
        "rtk rg -n \"Stable Context|Dynamic Context|Evidence Context|Excluded Context\""
      ],
      "forbidden_promotions": [
        "dynamic-to-AGENTS-without-review",
        "excluded-to-memory",
        "raw-session-log-to-archive"
      ],
      "artifacts": [
        "context-preflight markdown",
        "docs/context-layout.md"
      ]
    },
    {
      "name": "official-conversation-state-layering",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "scope": "OpenAI conversation-state concepts mapped to local context preflight, handoff and memory-promotion boundaries",
      "layers": {
        "stable": {
          "required_fields": [
            "durable user preferences",
            "reviewed repository rules",
            "versioned manifest contracts"
          ],
          "destinations": [
            "AGENTS.md",
            "manifest",
            "reviewed skill"
          ],
          "promotion_gate": "reviewed, secret-scanned, expires_at checked and covered by governance eval"
        },
        "dynamic": {
          "required_fields": [
            "current turn intent",
            "latest worktree status",
            "temporary plan state",
            "active blockers"
          ],
          "destinations": [
            "session summary",
            "context-preflight",
            "final response"
          ],
          "promotion_gate": "must be revalidated after resume and cannot become stable without explicit promotion review"
        },
        "evidence": {
          "required_fields": [
            "command",
            "exit code or result",
            "source URL",
            "retrieved_at",
            "artifact"
          ],
          "destinations": [
            "final evidence",
            "governance report",
            "archive note"
          ],
          "promotion_gate": "must remain reproducible or tied to official freshness metadata"
        },
        "excluded": {
          "required_fields": [
            "secrets",
            "private credentials",
            "raw session logs",
            "unreviewed personal memory",
            "unredacted private code snippets for external docs lookup"
          ],
          "destinations": [
            "none"
          ],
          "promotion_gate": "never promote"
        }
      },
      "validation_commands": [
        "rtk bash scripts/context-preflight.sh /tmp/context-preflight-check.md",
        "rtk bash scripts/doctor.sh --scope governance"
      ],
      "forbidden_promotions": [
        "previous-response-state-to-AGENTS-without-review",
        "dynamic-plan-to-memory",
        "excluded-context-to-docs-mcp",
        "raw-session-log-to-archive"
      ],
      "artifacts": [
        "context-preflight markdown",
        "official docs freshness gate",
        "conversation state layering review"
      ]
    }
  ]
}
