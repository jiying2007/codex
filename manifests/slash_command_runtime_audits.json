{
  "schema_version": 1,
  "slash_command_runtime_audits": [
    {
      "name": "slash-compact-runtime-audit",
      "enabled": true,
      "profiles": [
        "solo-dev",
        "team-collab"
      ],
      "command_contract": "slash-compact-context-handoff",
      "command": "/compact",
      "risk_class": "context-control",
      "audit_events": [
        "command invoked",
        "context layers identified",
        "excluded context checked",
        "handoff artifact produced"
      ],
      "runtime_controls": [
        "do not write long-term memory without review",
        "separate stable and dynamic context",
        "record blockers instead of dropping them"
      ],
      "required_evidence": [
        "context-preflight artifact",
        "stable/dynamic/evidence/excluded section check"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "discard-blockers",
        "silent-memory-write"
      ],
      "retention": "sanitized audit summary only",
      "review_required": true,
      "verification": [
        "rtk bash scripts/context-preflight.sh /tmp/context-preflight-check.md"
      ],
      "artifacts": [
        "context preflight markdown",
        "runtime audit summary"
      ]
    }
  ]
}
