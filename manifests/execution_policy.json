{
  "schema_version": 3,
  "engine": {
    "kind": "codex-native",
    "module": "tools.codex_assets.execution_policy.engine",
    "contract": "runtime_control.policy/v2",
    "behavior_baseline": {
      "repository": "jiying2007/agent-dev-kit",
      "version": "7.0.4",
      "commit": "1d6c28e89eb98a4af5ac978707730783f0c84437",
      "engine_blob": "05dd80065ec4c58c342e48ff12d4cd53d3897740",
      "support_blob": "626af591141b2dda6302edbe4363637435066628"
    }
  },
  "sources": {
    "state_db": "~/.codex/state_5.sqlite",
    "sessions_root": "~/.codex/sessions",
    "journal_dir": "~/.codex/execution-policy"
  },
  "policy": {
    "schema_version": "runtime_control.policy/v2",
    "token": {
      "checkpoint_ratio": 0.7,
      "compact_ratio": 0.9,
      "stop_ratio": 1
    },
    "context": {
      "compact_ratio": 0.5
    },
    "progress": {
      "staleness_seconds": 900,
      "retry_limit": 2,
      "no_progress_limit": 3
    },
    "artifact_applicability": {
      "readonly": {
        "steady": [],
        "final": [],
        "commit": null,
        "apply": null,
        "release": null
      },
      "implementation": {
        "steady": [],
        "final": [
          "repo",
          "build"
        ],
        "commit": [
          "repo",
          "build",
          "review"
        ],
        "apply": [
          "repo",
          "build",
          "plan",
          "dry-run"
        ],
        "release": null
      },
      "release": {
        "steady": [],
        "final": [
          "repo",
          "build"
        ],
        "commit": [
          "repo",
          "build",
          "review"
        ],
        "apply": [
          "repo",
          "build",
          "plan",
          "dry-run"
        ],
        "release": [
          "repo",
          "build",
          "live",
          "review"
        ]
      }
    },
    "mode_authority_policy": {
      "managed": true,
      "trusted_mode_authorities": [],
      "verification_backend": "not-configured"
    },
    "retention": {
      "journal_days": 14,
      "raw_content_stored": false
    }
  }
}
