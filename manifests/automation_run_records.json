{
  "schema_version": 1,
  "automation_run_records": [
    {
      "name": "health-report-record-template",
      "enabled": false,
      "automation": "codex-home-health-report",
      "run_id": "template",
      "run_at": "manual-template",
      "trigger": "scheduled-or-thread-wakeup",
      "status": "record-template",
      "triage": {
        "summary": "record source, priority and recommended human action",
        "priority": "review",
        "allowed_outputs": [
          "summary",
          "draft"
        ],
        "forbidden_actions": [
          "send",
          "commit",
          "delete",
          "publish"
        ]
      },
      "cleanup": {
        "performed": false,
        "actions": [
          "discard transient logs",
          "keep sanitized summary only"
        ]
      },
      "retention": {
        "policy": "summary-only",
        "expires_after": "next successful run unless archived"
      },
      "human_review": {
        "required": true,
        "status": "pending",
        "reviewer": "human"
      },
      "artifacts": [
        "automation triage summary",
        "sanitized run note"
      ]
    },
    {
      "name": "daily-activity-report-record-template",
      "enabled": false,
      "automation": "local-daily-activity-report",
      "run_id": "template",
      "run_at": "daily-20:30-asia-hong-kong",
      "trigger": "external-systemd-user-timer-after-explicit-user-authorization",
      "status": "record-template",
      "triage": {
        "summary": "record period, source coverage, privacy flags, output hashes and warnings",
        "priority": "review",
        "allowed_outputs": ["bounded receipt", "local report paths"],
        "forbidden_actions": ["send", "commit", "delete", "publish", "write memory"]
      },
      "cleanup": {
        "performed": false,
        "actions": ["discard transient command output", "keep hash-bound local report artifacts"]
      },
      "retention": {"policy": "local-tmp-until-explicit-cleanup", "expires_after": "none-automatic"},
      "human_review": {"required": true, "status": "pending-first-run-review", "reviewer": "human"},
      "artifacts": ["daily Markdown report", "daily JSON fact package", "SHA256 receipt"]
    },
    {
      "name": "weekly-activity-report-record-template",
      "enabled": false,
      "automation": "local-weekly-activity-report",
      "run_id": "template",
