{
  "schema_version": 1,
  "cli_command_contracts": [
    {
      "name": "slash-goal-strong-target",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/goal",
      "purpose": "turn an ambitious task into an explicit endpoint with validation evidence",
      "input_contract": [
        "goal statement",
        "scope and non-goals",
        "success criteria",
        "verification commands",
        "review artifacts"
      ],
      "allowed_actions": [
        "create or update goal template",
        "run declared verification",
        "summarize open blockers"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "silently widen scope",
        "claim completion without evidence"
      ],
      "output_contract": [
        "goal closure summary",
        "verification evidence",
        "open items"
      ],
      "review_required": true,
      "verification": [
        "rtk bash scripts/final-ready.sh"
      ]
    },
    {
      "name": "slash-review-quality-gate",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/review",
      "purpose": "review code or asset changes for correctness, risk and missing tests before delivery",
      "input_contract": [
        "changed file list",
        "intended behavior",
        "verification already run",
        "known risks"
      ],
      "allowed_actions": [
        "inspect diffs",
        "classify findings",
        "recommend focused fixes"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "hide blocker findings",
        "rewrite unrelated user changes"
      ],
      "output_contract": [
        "findings ordered by severity",
        "test gaps",
        "residual risk"
      ],
      "review_required": true,
      "verification": [
        "rtk git diff --check",
        "rtk bash scripts/check.sh"
      ]
    },
    {
      "name": "slash-compact-context-handoff",
      "enabled": true,
      "profiles": [
        "solo-dev",
        "team-collab"
      ],
      "command": "/compact",
      "purpose": "prepare a stable and dynamic context handoff before thread switch or context pressure",
      "input_contract": [
        "current goal",
        "stable decisions",
        "dynamic worktree state",
        "next executable action"
      ],
      "allowed_actions": [
        "generate context preflight",
        "separate stable and dynamic context",
        "record resume prompt"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "write long-term memory without review",
        "discard unresolved blockers"
      ],
      "output_contract": [
        "context preflight artifact",
        "resume prompt",
        "open items"
      ],
      "review_required": true,
      "verification": [
        "rtk bash scripts/context-preflight.sh /tmp/context-preflight-check.md"
      ]
    },
    {
      "name": "slash-plan-execution-contract",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/plan",
      "purpose": "turn a medium or large local task into staged work with scope, risks, evidence and stop conditions",
      "input_contract": [
        "goal statement",
        "scope and non-goals",
        "risk assumptions",
        "verification commands",
        "stop conditions"
      ],
      "allowed_actions": [
        "create or update task plan",
        "identify blocked items",
        "select local verification commands"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "start external integration",
        "hide unresolved blockers"
      ],
      "output_contract": [
        "staged plan",
        "risk ledger",
        "verification map",
        "open blockers"
      ],
      "review_required": true,
      "verification": [
        "rtk bash scripts/doctor.sh --scope governance",
        "rtk bash scripts/final-ready.sh"
      ]
    },
    {
      "name": "slash-status-local-audit",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/status",
      "purpose": "summarize local repo, asset, drift and verification state without modifying files",
      "input_contract": [
        "current goal or status request",
        "desired scope: repo, assets, live drift or checks",
        "known blockers"
      ],
      "allowed_actions": [
        "inspect git status",
        "inspect governance report",
        "inspect drift and final-ready state"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "modify files",
        "apply live changes"
      ],
      "output_contract": [
        "changed file summary",
        "verification state",
        "drift state",
        "next local action"
      ],
      "review_required": true,
      "verification": [
        "rtk git status --short",
        "rtk bash scripts/drift.sh",
        "rtk bash scripts/final-ready.sh"
      ]
    },
    {
      "name": "slash-mcp-local-readonly-audit",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/mcp",
      "purpose": "audit local MCP declarations, enabled state, tool inventory and fallback policy without enabling new external writes",
      "input_contract": [
        "MCP server name or audit scope",
        "read/write expectation",
        "fallback requirement",
        "approval boundary"
      ],
      "allowed_actions": [
        "list configured MCP servers",
        "compare manifest readiness with runtime state",
        "summarize deny-path and credential boundaries"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "enable external-write MCP",
        "write credentials",
        "upload private code"
      ],
      "output_contract": [
        "MCP status summary",
        "permission boundary",
        "fallback decision",
        "verification evidence"
      ],
      "review_required": true,
      "verification": [
        "rtk codex mcp list",
        "rtk bash scripts/doctor.sh --scope governance"
      ]
    },
    {
      "name": "slash-knowledge-status",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/knowledge-status",
      "purpose": "summarize Knowledge Hub registry, source and validation state without modifying files",
      "input_contract": [
        "status request",
        "optional project or domain filter",
        "known blockers"
      ],
      "allowed_actions": [
        "run Knowledge Hub dry-run checks",
        "search registered sources",
        "summarize stale, broken or missing registry items"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "modify knowledge files",
        "promote candidates",
        "delete files",
        "write memories"
      ],
      "output_contract": [
        "knowledge health summary",
        "source state",
        "next local action"
      ],
      "review_required": true,
      "verification": [
        "rtk bash ~/knowledge-hub/tools/knowledge-check.sh --dry-run",
        "rtk bash scripts/final-ready.sh"
      ]
    },
    {
      "name": "slash-knowledge-promote",
      "enabled": true,
      "profiles": [
        "team-collab"
      ],
      "command": "/knowledge-promote",
      "purpose": "create a reviewed dry-run plan for promoting a Knowledge Hub item across authority levels",
      "input_contract": [
        "item id",
        "target domain",
        "promotion reason",
        "validation evidence"
      ],
      "allowed_actions": [
        "run dry-run promotion planning",
        "summarize required source evidence",
        "list registry changes that would be required"
      ],
      "forbidden_actions": [
        "bypass-verification",
        "apply promotion without a separate explicit execution request",
        "copy project-specific content into team standards",
        "write AGENTS.md",
        "write memories"
      ],
      "output_contract": [
        "promotion plan",
        "required review gates",
        "blocked or missing evidence"
      ],
      "review_required": true,
      "verification": [
        "rtk bash ~/knowledge-hub/tools/knowledge-promote.sh --id <id> --target <domain> --dry-run",
        "rtk bash ~/knowledge-hub/tools/knowledge-check.sh --dry-run"
      ]
    }
  ]
}
