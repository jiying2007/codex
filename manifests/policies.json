{
  "schema_version": 2,
  "protected_paths": [
    "skills/.system/**",
    "auth.json",
    "sessions/**",
    "log/**",
    "logs_*.sqlite*",
    "state_*.sqlite*",
    "cache/**",
    "tmp/**",
    ".tmp/**",
    "shell_snapshots/**",
    "mcp/secrets/**",
    "config.local.*",
    "**/*.secret",
    "**/*.key",
    "**/*.pem"
  ],
  "skip_source_paths": [
    ".git/**",
    ".codex/**",
    "control/state/backup/**"
  ],
  "allowed_live_drift_paths": [
    "config.toml"
  ],
  "retired_live_paths": [
    "vendor/plugins/superpowers"
  ],
  "default_apply_mode": "keep-existing",
  "overwrite_requires_backup": true
}
