{
  "schema_version": 2,
  "engine": {
    "kind": "codex-native",
    "module": "tools.codex_assets.runtime_kernel",
    "contract": "runtime_control.v1",
    "behavior_baseline": {
      "repository": "jiying2007/agent-dev-kit",
      "version": "5.1.0",
      "commit": "59cbd5cb40ca7077ee5407636bfc617e295ec7e5",
      "engine_blob": "c01f71f2d8518266f947d696b8828cb102859ce1",
      "support_blob": "4dbb0d10c0733f8cc7a897d5325cf819a34872f0"
    }
  },
  "sources": {
    "state_db": "~/.codex/state_5.sqlite",
    "sessions_root": "~/.codex/sessions",
    "journal_dir": "~/.codex/runtime-control"
  },
  "policy": {
    "schema_version": "runtime_control.policy/v1",
    "token": {
      "checkpoint_ratio": 0.7,
      "compact_ratio": 0.9,
      "stop_ratio": 1.0
    },
    "context": {
      "compact_ratio": 0.5
    },
    "progress": {
      "staleness_seconds": 900,
      "retry_limit": 2,
      "no_progress_limit": 3
    },
    "gate_policy": {
      "steady": [],
      "final": ["repo", "build"],
      "commit": ["repo", "build", "review"],
      "apply": ["repo", "build", "plan", "dry-run"],
      "release": ["repo", "build", "live", "review"]
    },
    "retention": {
      "journal_days": 14,
      "raw_content_stored": false
    }
  }
}
