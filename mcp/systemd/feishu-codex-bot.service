[Unit]
Description=Feishu Codex AI Assistant
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/codex
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/codex/scripts/feishu-codex-bot.sh start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
