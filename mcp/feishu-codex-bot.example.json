{
  "schema_version": 1,
  "engineering_enabled": true,
  "agent_intake_enabled": false,
  "default_repo": "app",
  "allowed_open_ids": [
    "ou_example_owner"
  ],
  "repositories": {
    "app": {
      "path": "/srv/feishu-agent/repos/example-app",
      "allowed_modes": [
        "explain",
        "review",
        "edit"
      ],
      "allowed_open_ids": [],
      "agent_allowed_modes": [],
      "edit_strategy": "worktree",
      "worktree_root": "/srv/feishu-agent/worktrees/app",
      "base_ref": "main",
      "branch_prefix": "feishu/app",
      "commit_enabled": true,
      "verification_commands": [
        [
          "git",
          "diff",
          "--check"
        ]
      ],
      "github_delivery": {
        "repository": "example-org/example-app",
        "base_branch": "main",
        "required_workflows": [
          ".github/workflows/verify.yml"
        ],
        "publish_enabled": false
      },
      "document_read_urls": []
    },
    "firmware": {
      "path": "/srv/feishu-agent/repos/example-firmware",
      "allowed_modes": [
        "explain",
        "review",
        "edit"
      ],
      "allowed_open_ids": [],
      "agent_allowed_modes": [],
      "edit_strategy": "worktree",
      "worktree_root": "/srv/feishu-agent/worktrees/firmware",
      "base_ref": "main",
      "branch_prefix": "feishu/firmware",
      "commit_enabled": true,
      "verification_commands": [
        [
          "git",
          "diff",
          "--check"
        ]
      ],
      "github_delivery": {
        "repository": "example-org/example-firmware",
        "base_branch": "main",
        "required_workflows": [
          ".github/workflows/verify.yml"
        ],
        "publish_enabled": false
      },
      "document_read_urls": []
    }
  },
  "link_repositories": {
    "feishu_project:example-space": [
      "app",
      "firmware"
    ],
    "tapd:10000001": [
      "app"
    ]
  },
  "deny_push_hooks_path": "/home/service/codex/mcp/git-hooks",
  "isolation_bin": "bwrap",
  "deny_read_paths": [
    "/srv/feishu-agent/private"
  ],
  "isolation_write_paths": [],
  "worker_count": 1,
  "queue_size": 20,
  "rate_limit_count": 5,
  "rate_limit_window_sec": 60,
  "codex_timeout_sec": 900,
  "max_prompt_chars": 12000,
  "reply_chunk_chars": 3500,
  "state_db": "/srv/feishu-agent/private/feishu-codex-state.sqlite3",
  "lock_file": "/srv/feishu-agent/private/feishu-codex-bot.lock",
  "agent_codex_home": "/srv/feishu-agent/runtime/codex-home",
  "sandbox_read_paths": []
}
